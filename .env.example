# Public address of the site, used in invite links and emails
SITE_URL=https://winter-arc.vercel.app

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login
ADMIN_PASSWORD=pick-a-long-password
# Any long random string; signs the admin cookie
SESSION_SECRET=

# Email over SMTP. For Gmail: turn on 2-step verification, create an App Password,
# then use smtp.gmail.com / 465 / your address / the 16-letter app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM=Winter Arc <you@gmail.com>

# Vercel sends this as a Bearer token to the daily cron route
CRON_SECRET=
